# ---------- Required ----------
# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/xtovia-affiliate

# Port the backend runs on
PORT=5001

# Your Shopify store page that affiliate links open (customers can still buy anything)
STORE_URL=https://xtovia.com/products/hair-revival-system

# Long random string used to sign login tokens
JWT_SECRET=replace-with-a-long-random-string

# ---------- URLs ----------
# Public URL of this backend (used to build tracking links)
PUBLIC_API_URL=http://localhost:5001
# URL of the React frontend (allowed by CORS)
CLIENT_URL=http://localhost:5173

# ---------- Commissions ----------
# Days a commission stays "pending" before auto-approval (your return window)
COMMISSION_HOLD_DAYS=7
# Discount customers get with an affiliate coupon (0 = tracking-only: no coupons, plain links)
COUPON_DISCOUNT_PERCENT=10
# true = commission only on a customer's first-ever order (returning customers earn nothing)
COMMISSION_NEW_CUSTOMERS_ONLY=false

# ---------- Shopify (needed from Step 3/4) ----------
# Your store's .myshopify.com domain
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# App credentials - fill EITHER the access token OR the client id + secret
# Scopes needed: write_discounts, read_orders, read_customers
# a) Older custom app made in Shopify admin: its Admin API access token
SHOPIFY_ADMIN_ACCESS_TOKEN=
# b) App made in the Shopify Dev Dashboard: its client id and secret
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Admin API version
SHOPIFY_API_VERSION=2026-07
# Webhook signing secret. Leave empty if you used `npm run register-webhooks`
# with option (b) - the client secret is used. If you created the webhooks in
# Shopify admin > Settings > Notifications, paste the key shown there.
SHOPIFY_WEBHOOK_SECRET=

# ---------- Vercel ----------
# Long random string; Vercel Cron sends it to /api/cron/approve-commissions
CRON_SECRET=

# ---------- First admin (used once by npm run create-admin) ----------
ADMIN_EMAIL=you@xtovia.com
ADMIN_PASSWORD=choose-a-strong-password
